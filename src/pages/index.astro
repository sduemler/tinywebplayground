---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { projects } from "../data/projects";

// Newest first for the index modal. Reversing before the (stable) sort puts the
// later registry entry first when two projects went up the same day.
const indexEntries = [...projects]
    .reverse()
    .sort((a, b) => b.added.localeCompare(a.added))
    .map((p) => ({
        ...p,
        href: p.externalUrl ?? `/projects/${p.slug}`,
        addedLabel: new Date(`${p.added}T00:00:00Z`).toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
            timeZone: "UTC",
        }),
    }));
---

<BaseLayout title="tinywebplayground">
    <div class="page">
        <header class="site-header">
            <h1 class="site-title">
                <span class="t-drop">t</span><span class="middle-letters"
                    >inywebplaygroun</span
                ><span class="t-drop">d</span>
            </h1>
            <button
                type="button"
                class="index-btn"
                id="index-open"
                aria-haspopup="dialog"
                aria-controls="index-dialog">Index</button
            >
        </header>

        <dialog class="index-dialog" id="index-dialog" aria-labelledby="index-title">
            <div class="index-head">
                <h2 class="index-title" id="index-title">Index</h2>
                <span class="index-count">{projects.length} projects</span>
                <button
                    type="button"
                    class="index-close"
                    id="index-close"
                    aria-label="Close index">×</button
                >
            </div>
            <ol class="index-list">
                {indexEntries.map((p) => (
                    <li class="index-item" style={`--item-accent: ${p.accentColor};`}>
                        <a
                            class="index-link"
                            href={p.href}
                            {...(p.externalUrl ? { target: "_blank", rel: "noopener" } : {})}
                        >
                            {p.title}
                            {p.externalUrl && <span class="index-ext" aria-label="(opens its own site)"> ↗</span>}
                        </a>
                        <time class="index-date" datetime={p.added}>{p.addedLabel}</time>
                        <p class="index-desc">{p.description}</p>
                    </li>
                ))}
            </ol>
        </dialog>

        <main class="hub">
            <div class="grid">
                {projects.map((project, i) => (
                    <ProjectCard project={project} eager={i < 3} />
                ))}
            </div>
        </main>

        <section class="subscribe">
            <h2 class="subscribe-title">Stay in the loop</h2>
            <p class="subscribe-desc">
                Get notified when new projects are added.
            </p>
            <form class="subscribe-form" id="subscribe-form">
                <input
                    type="email"
                    class="subscribe-input"
                    placeholder="your@email.com"
                    required
                    aria-label="Email address"
                    id="subscribe-email"
                />
                <button type="submit" class="subscribe-btn" id="subscribe-btn"
                    >Subscribe</button
                >
            </form>
            <p class="subscribe-msg" id="subscribe-msg" aria-live="polite"></p>
        </section>

        <SiteFooter />
    </div>
</BaseLayout>

<style>
    .page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .site-header {
        text-align: center;
        padding: 3rem 1.5rem 2rem;
    }

    .site-title {
        font-family: var(--font-display);
        font-size: 2.8rem;
        font-weight: 400;
        margin: 0;
        color: var(--color-text);
        line-height: 1;
        letter-spacing: -0.01em;
    }

    .t-drop {
        font-size: 5.2rem;
        line-height: 0.75;
        display: inline-block;
        vertical-align: -0.15em;
        color: var(--color-accent);
    }

    .middle-letters {
        text-decoration: underline;
        text-decoration-color: var(--color-accent);
        text-decoration-thickness: 3px;
        text-underline-offset: 4px;
    }

    .index-btn {
        margin-top: 1.25rem;
        padding: 0.4rem 1.1rem;
        min-height: 34px;
        border: 2px solid var(--color-border);
        border-radius: 999px;
        background: var(--color-surface);
        color: var(--color-text);
        font-family: var(--font-display);
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        cursor: pointer;
        transition:
            border-color var(--transition),
            color var(--transition),
            transform var(--transition);
    }

    .index-btn:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        transform: translateY(-1px);
    }

    .index-btn:focus-visible,
    .index-close:focus-visible,
    .index-link:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }

    .index-dialog {
        width: min(640px, calc(100vw - 2rem));
        max-height: min(80vh, 760px);
        padding: 0;
        border: 2px solid var(--color-border);
        border-radius: var(--radius);
        background: var(--color-surface);
        color: var(--color-text);
        box-shadow: 0 16px 48px rgba(59, 42, 26, 0.25);
        overflow: hidden;
    }

    .index-dialog[open] {
        display: flex;
        flex-direction: column;
    }

    .index-dialog::backdrop {
        background: rgba(59, 42, 26, 0.45);
    }

    :global(body:has(.index-dialog[open])) {
        overflow: hidden;
    }

    .index-head {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        padding: 1rem 1rem 0.75rem 1.5rem;
        border-bottom: 2px solid var(--color-border);
        background: var(--color-accent-light);
    }

    .index-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 400;
        margin: 0;
    }

    .index-count {
        color: var(--color-muted);
        font-size: 0.9rem;
    }

    .index-close {
        margin-left: auto;
        align-self: center;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: var(--color-muted);
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        transition:
            background var(--transition),
            color var(--transition);
    }

    .index-close:hover {
        background: var(--color-surface);
        color: var(--color-accent);
    }

    .index-list {
        list-style: none;
        margin: 0;
        padding: 0.25rem 1.5rem 1rem;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .index-item {
        display: grid;
        grid-template-columns: 1fr auto;
        column-gap: 1rem;
        padding: 0.85rem 0 0.85rem 0.85rem;
        border-bottom: 1px dashed var(--color-border);
        border-left: 3px solid var(--item-accent);
        margin: 0.5rem 0;
    }

    .index-item:last-child {
        border-bottom: none;
    }

    .index-link {
        font-family: var(--font-display);
        font-size: 1.1rem;
        color: var(--color-text);
        text-decoration: none;
        transition: color var(--transition);
    }

    .index-link:hover {
        color: var(--color-accent);
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }

    .index-ext {
        color: var(--color-muted);
        font-size: 0.9em;
    }

    .index-date {
        color: var(--color-muted);
        font-size: 0.85rem;
        white-space: nowrap;
        align-self: baseline;
    }

    .index-desc {
        grid-column: 1 / -1;
        margin: 0.2rem 0 0;
        color: var(--color-muted);
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .hub {
        flex: 1;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem 3rem;
        width: 100%;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .subscribe {
        max-width: 480px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
        text-align: center;
    }

    .subscribe-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 400;
        color: var(--color-text);
        margin: 0 0 0.25rem;
    }

    .subscribe-desc {
        color: var(--color-muted);
        font-size: 0.95rem;
        margin: 0 0 1rem;
    }

    .subscribe-form {
        display: flex;
        gap: 0.5rem;
    }

    .subscribe-input {
        flex: 1;
        padding: 0.6rem 0.9rem;
        border: 2px solid var(--color-border);
        border-radius: var(--radius);
        background: var(--color-surface);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 0.95rem;
        outline: none;
        transition: border-color var(--transition);
    }

    .subscribe-input:focus {
        border-color: var(--color-accent);
    }

    .subscribe-input::placeholder {
        color: var(--color-muted);
        opacity: 0.6;
    }

    .subscribe-btn {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: var(--radius);
        background: var(--color-accent);
        color: var(--color-rich-text);
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 400;
        cursor: pointer;
        transition:
            background var(--transition),
            transform var(--transition);
        white-space: nowrap;
    }

    .subscribe-btn:hover {
        background: var(--color-rich);
        transform: translateY(-1px);
    }

    .subscribe-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .subscribe-btn.success {
        background: #5a7a3a;
        opacity: 1;
        cursor: default;
        pointer-events: none;
        animation: pop 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes pop {
        0% { transform: scale(1); }
        50% { transform: scale(1.25); }
        100% { transform: scale(1); }
    }

    .subscribe-input:disabled {
        opacity: 0.7;
        cursor: default;
    }

    .subscribe-msg {
        font-size: 0.85rem;
        margin: 0.75rem 0 0;
        min-height: 1.3em;
    }

    .subscribe-msg.success {
        color: #5a7a3a;
    }

    .subscribe-msg.error {
        color: #b04a2e;
    }

    @media (max-width: 900px) {
        .grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 560px) {
        .site-title {
            font-size: 2rem;
        }

        .t-drop {
            font-size: 3.8rem;
        }

        .middle-letters {
            text-decoration-thickness: 2px;
        }

        .grid {
            grid-template-columns: 1fr;
        }

        .subscribe-form {
            flex-direction: column;
        }

        .index-dialog {
            max-height: 85vh;
        }

        .index-head {
            padding-left: 1rem;
        }

        .index-list {
            padding: 0.25rem 1rem 1rem;
        }

        .index-item {
            grid-template-columns: 1fr;
        }

        .index-date {
            grid-row: 2;
            margin-top: 0.1rem;
        }
    }
</style>

<script>
    const indexDialog = document.getElementById(
        "index-dialog",
    ) as HTMLDialogElement;
    document
        .getElementById("index-open")!
        .addEventListener("click", () => indexDialog.showModal());
    document
        .getElementById("index-close")!
        .addEventListener("click", () => indexDialog.close());
    // The dialog's children fill it edge to edge, so a click that lands on the
    // dialog element itself is a click on the backdrop.
    indexDialog.addEventListener("click", (e) => {
        if (e.target === indexDialog) indexDialog.close();
    });

    const form = document.getElementById("subscribe-form") as HTMLFormElement;
    const input = document.getElementById(
        "subscribe-email",
    ) as HTMLInputElement;
    const btn = document.getElementById("subscribe-btn") as HTMLButtonElement;
    const msg = document.getElementById(
        "subscribe-msg",
    ) as HTMLParagraphElement;

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        btn.disabled = true;
        msg.textContent = "";
        msg.className = "subscribe-msg";

        try {
            const res = await fetch("/api/subscribe", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: input.value.trim() }),
            });
            const data = await res.json();

            if (data.success) {
                msg.textContent =
                    "You're subscribed! Check your email to confirm.";
                msg.classList.add("success");
                input.disabled = true;
                btn.innerHTML = "👍";
                btn.classList.add("success");
                return;
            } else {
                msg.textContent = data.error || "Something went wrong.";
                msg.classList.add("error");
            }
        } catch {
            msg.textContent = "Something went wrong. Please try again.";
            msg.classList.add("error");
        }
        btn.disabled = false;
    });
</script>
