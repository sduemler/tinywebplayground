---
import type { Project } from '../data/projects';
import styles from './ProjectCard.module.css';

interface Props {
  project: Project;
  /** Load the image eagerly (cards in the first row, above the fold). */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const statusLabel = { live: null, wip: 'WIP', 'coming-soon': 'Soon' }[project.status];
---

<a
  href={`/projects/${project.slug}`}
  class={styles.card}
  style={`--card-accent: ${project.accentColor};`}
>
  {statusLabel && <span class={styles.status}>{statusLabel}</span>}
  {project.image ? (
    <img
      src={project.image}
      alt=""
      width="800"
      height="600"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class={styles.image}
      style={[
        project.imagePosition ? `object-position: ${project.imagePosition}` : null,
        project.imageFit ? `object-fit: ${project.imageFit}` : null,
      ].filter(Boolean).join('; ') || undefined}
    />
  ) : (
    <div class={styles.imagePlaceholder}>✦</div>
  )}
  <div class={styles.body}>
    {project.titleHtml ? (
      <h2 class={styles.title} set:html={project.titleHtml} />
    ) : (
      <h2 class={styles.title}>{project.title}</h2>
    )}
  </div>
</a>
