---
export const prerender = true;
import ProjectLayout from "@layouts/ProjectLayout.astro";
import { projects } from "@data/projects";
import BehindTheCounter from "@components/projects/behind-the-counter/BehindTheCounter";

const project = projects.find((p) => p.slug === "behind-the-counter")!;
---

<ProjectLayout project={project} subtitle="Every shop from the series">
  <BehindTheCounter client:only="react" />
</ProjectLayout>
