---
export const prerender = true;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CardGallery from "../../../components/projects/philosopher-tcg/CardGallery";
---

<BaseLayout
  title="First Principles — Card Index"
  description="Review gallery: all 50 philosopher cards rendered full-size."
  themeColor="#070b1a"
  noindex={true}
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
  />
  <div class="tcg-index-page">
    <CardGallery client:load />
  </div>
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    background: #070b1a;
  }
  .tcg-index-page {
    min-height: 100vh;
    background: #070b1a;
  }
</style>
