---
export const prerender = true;
import ProjectLayout from "@layouts/ProjectLayout.astro";
import { projects } from "@data/projects";
import AkeelahList from "../../components/projects/from-akeelah-to-z/AkeelahList";

const project = projects.find((p) => p.slug === "from-akeelah-to-z")!;
---

<ProjectLayout project={project}>
  <AkeelahList client:load />
</ProjectLayout>

<!-- Warm-blue palette, scoped to this project page only (the rest of the site
     keeps its earthy theme). Overriding the tokens on .project-wrapper retints
     the header, content, and footer; body covers the page background. -->
<style is:global>
  body {
    background-color: #eaf1f8;
  }

  .project-wrapper {
    --color-bg: #eaf1f8;
    --color-text: #1f3148;
    --color-muted: #5f7896;
    --color-surface: #fbfdff;
    --color-border: #c4d6e8;
    --color-accent: #3f72a4;
    --color-accent-light: #dbe7f4;
    --color-rich: #2a4a6b;
    --color-rich-text: #eef5fc;
  }
</style>
